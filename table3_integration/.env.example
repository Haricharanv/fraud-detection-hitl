# Fraud Detection HITL Integration Layer -- Environment Variables

# SQLite (default, no setup needed):
DATABASE_URL=sqlite+aiosqlite:///./fraud_detection.db

# PostgreSQL (uncomment and edit if using PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fraud_detection

# FastAPI backend URL (used by Streamlit app)
BACKEND_URL=http://localhost:8000
